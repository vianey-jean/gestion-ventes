# =============================================================================
# Double authentification (2FA) — Codes OTP à 6 chiffres
# =============================================================================
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_PER_HOUR=8
PENDING_REGISTRATION_TTL_HOURS=24

# URL du frontend (utilisée si des liens sont générés dans les emails)
#FRONTEND_URL=https://riziky-ventes.vercel.app
FRONTEND_URL=http://localhost:10000

# =============================================================================
# Envoi d'emails (SMTP) — nodemailer
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# et un "mot de passe d'application" Gmail (pas le mot de passe du compte)
# =============================================================================
SMTP_HOST=smtp.gmail.com 
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vianey1.jean@gmail.com
SMTP_PASS=nsmivuqhqitirunj
MAIL_FROM=vianey1.jean@gmail.com
MAIL_FROM_NAME=Gestion Vente
SMTP_TLS_REJECT_UNAUTHORIZED=false

# =============================================================================
# Envoi de SMS (Twilio) — OPTIONNEL. Si vide, le SMS est simulé (dry-run) et
# le canal email est utilisé automatiquement à la place.
# npm install twilio  (à installer uniquement si vous activez le SMS)
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
